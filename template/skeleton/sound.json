{
  "about": "Cue sheet: only the effects that carry a beat (about 45 a minute). Files are looked up in sfx/ here, then template/sfx, template/sfx/basic, template/music. The bed stays audible under every natural pause (patch + level). See references/09-sound-and-music.md.",
  "bed": { "file": "bed.mp3", "underSpeech": -34, "measure": [1, 30], "patch": [17.85, 19.2, 9.6], "splice": [37.5, 12], "level": { "window": 0.5, "ref": 0.7, "maxLift": 8 },
           "title": { "from": "@shot title -0.05", "level": -31 },
           "chapter": { "from": "@shot chapter", "level": -48, "ramp": 0.35 } },
  "duck": -10,
  "roomTone": null,
  "loudness": { "I": -14, "TP": -2.5, "limit": 0.70 },
  "cues": [
    { "beat": "hook", "file": "city_amb", "at": 0.0, "gain": -4, "until": "@shot board +0.1", "bus": "amb" },
    { "file": "basic/thump", "at": 0.02, "gain": -3 },
    { "file": "basic/whoosh", "at": "@shot board -0.06", "gain": -12 },
    { "file": "counter_roll", "at": "@ws NA TODO", "gain": -16, "until": "@we NA TODO +0.1", "bus": "amb" },
    { "file": "basic/impact", "at": "@we NA TODO -0.05", "gain": -16 },
    { "file": "basic/typing", "at": "@shot card1 +0.03", "gain": -4, "until": "@shotend card1 -0.07", "bus": "amb" },
    { "beat": "skit", "file": "surprise_sting", "at": "@ws S1 TODO -0.02", "gain": -17 },
    { "file": "basic/pop", "at": "@ws S2 TODO", "gain": -15 },
    { "beat": "title question", "file": "basic/typing", "at": "@shot card2 +0.03", "gain": -4, "until": "@shotend card2 -0.07", "fade": 0.1, "bus": "amb" },
    { "beat": "title card", "file": "basic/riser", "at": "@shot title +1.0 -1.53", "gain": -19 },
    { "file": "title_hit", "at": "@shot title +1.0", "gain": -20 },
    { "file": "basic/whoosh_big", "at": "@shot title +1.8 -0.45", "gain": -24 }
  ]
}
